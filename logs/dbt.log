            WHEN country IS NULL OR trim(country) = '' THEN 'missing_country'
            WHEN sex IS NOT NULL
                 AND lower(trim(sex)) NOT IN ('male','female','m','f')
                THEN 'invalid_sex'
            ELSE NULL
        END AS quarantine_reason
    FROM "ingestion"."main_raw"."raw_ims_clients"
)
SELECT * FROM scored
    );
    
  
